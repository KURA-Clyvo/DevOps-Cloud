# =============================================================================
# KURA · Infraestrutura · .env.example
# Copie para .env e preencha antes de rodar: cp .env.example .env
# NUNCA commite o .env real — ele está no .gitignore
# =============================================================================

# ─── Oracle XE (banco containerizado) ────────────────────────────────────────
# Gere com: openssl rand -base64 32
ORACLE_SYS_PASSWORD=
ORACLE_APP_USER=RM562999
# Gere com: openssl rand -base64 32
ORACLE_APP_PASSWORD=

# ─── .NET API ────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# Gere com: openssl rand -base64 48
DOTNET_JWT_KEY=
# Gere com: openssl rand -base64 32
IOT_API_KEY=
# Gere com: openssl rand -base64 32
LUNA_API_KEY=
# Auth inbound de POST /whatsapp/enviar na Luna (mobile-clinica-rn → Luna direto,
# não passa pelo .NET). Deve bater com EXPO_PUBLIC_LUNA_API_KEY do mobile-clinica-rn/.env.
# TAMBÉM é a chave que o kura-api (.NET) manda no header X-API-Key ao chamar
# POST /transcricao na Luna (Luna__InboundApiKey) — mesma variável, um valor só,
# usada pelos dois serviços (luna-ai valida, kura-api envia). Nunca duplicar o literal.
# Gere com: openssl rand -base64 32
LUNA_INBOUND_API_KEY=
# Daily.co — cria a sala de vídeo da teleconsulta (FEAT-01). Sem isto (ou com valor
# inválido), o .NET aplica fallback de link manual em vez de falhar — ver DailyService.cs.
DAILY_API_KEY=kura-daily-dummy-key-2026
# URL da Luna vista pelo .NET dentro da rede docker (nome do serviço = hostname).
# Usada só para transcrição de áudio → draft SOAP (FEAT-02), não para o restante da
# integração Luna→.NET (essa direção já usa LUNA_API_KEY/KURA_API_BASE_URL do serviço luna-ai).
LUNA_BASE_URL=http://luna-ai:8000
# Pasta onde o kura-api grava os PDFs de receituário (Documento.DsCaminho, FEAT-03).
# Montada como named volume (kura_storage_documentos) para persistir entre
# `docker compose down`/recreate — sem isto, os PDFs vivem só na camada do
# container e somem a cada recreate (não precisa de `down -v` para sumir).
STORAGE_BASE_PATH=/data/kura/receituarios

# ─── Java API ────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JAVA_JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Twilio WhatsApp (Luna IA) ────────────────────────────────────────────────
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+14155238886
WEBHOOK_PUBLIC_URL=https://xxxx.ngrok.io/webhook/twilio/whatsapp

# ─── OpenAI (Luna IA) ──────────────────────────────────────────────────────────
# Whisper — transcrição de áudio → draft SOAP (FEAT-02, POST /transcricao).
# Opcional: sem isto, o endpoint responde 200 com {transcricao: null, soap: null}
# em vez de falhar (ver transcricao_service.py:62 e web/routers/transcricao.py:76).
# Custo real (~$0.006/min de áudio) — preencher só se for demonstrar a FEAT-02.
OPENAI_API_KEY=
